# 百度人脸识别API配置（如需要人脸识别配置，否则不用配置）
# 请在百度AI开放平台(https://ai.baidu.com/)申请API Key和Secret Key
# 百度人脸识别API密钥 (必须)
BAIDU_FACE_API_KEY=your_api_key_here
BAIDU_FACE_SECRET_KEY=your_secret_key_here
# 人脸库组ID (必须，需要在百度AI平台创建人脸库并获取组ID)
BAIDU_FACE_GROUP_ID=your_group_id_here

# 豆包语音服务
# 注册/获取密钥：https://console.volcengine.com/speech/app
DOUBAO_APP_ID="your_app_id_here"
DOUBAO_ACCESS_TOKEN="your_access_token_here"
# 默认不需要：仅 STT 且 auth_method="signature" 时才需要
DOUBAO_ACCESS_SECRET="your_access_secret_here"
